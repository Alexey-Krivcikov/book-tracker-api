generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserBook {
  id          String   @id @default(uuid())

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  title       String
  description String?
  authors     String[]
  cover       String?
  status      String
  rating      Int?
  createdAt   DateTime @default(now())

  @@unique([userId, title])
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  createdAt DateTime   @default(now())

  userBooks UserBook[]
}
